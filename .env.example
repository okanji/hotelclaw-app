# =============================================================================
# hotelclaw-app — environment variables
#
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# gitignored; never commit secrets. Restart `pnpm dev` after changes — Next
# only reads .env files on boot.
#
# Variables prefixed with NEXT_PUBLIC_ are inlined into the browser bundle
# and exposed to every visitor. Everything else stays server-only.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Project URL — visible in the Supabase dashboard under Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anonymous "publishable" key. Safe to ship to the browser; RLS is the
# real authorization layer.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGci...

# Service-role key. NEVER exposed to the browser. Used by webhook receivers
# and the calendar push helpers, which run without a user session and need
# to bypass RLS to write `external_events` etc. Treat like a database
# password.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...


# -----------------------------------------------------------------------------
# Stream Chat (messaging + video)
# -----------------------------------------------------------------------------
# Public API key — used by the browser client to connect.
NEXT_PUBLIC_STREAM_API_KEY=...

# Server-side secret for minting user tokens, posting system messages,
# verifying webhook signatures.
STREAM_API_SECRET=...


# -----------------------------------------------------------------------------
# Liveblocks (collaborative docs + presence)
# -----------------------------------------------------------------------------
# Server-side secret for room access tokens.
LIVEBLOCKS_SECRET_KEY=sk_...

# Verifies Liveblocks webhook payloads (document update notifications).
LIVEBLOCKS_WEBHOOK_SECRET=whsec_...


# -----------------------------------------------------------------------------
# Resend (transactional email — invites, password resets)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_...


# =============================================================================
# Calendar integration (migration 0017 + 0018)
# =============================================================================
# Everything below is optional. Without it, the in-app calendar still
# works — you just lose external sync (Google/Outlook), push delivery
# (events appear on next focus-poll instead), and at-rest token encryption.
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# Token encryption
# -----------------------------------------------------------------------------
# AES-256-GCM key for encrypting `calendar_connections.access_token` /
# `refresh_token` at rest. Generate ONCE per environment and never rotate
# without re-encrypting (a rotation script would walk all rows, decrypt
# with the old key, encrypt with the new one).
#
#   openssl rand -base64 32
#
# When unset, the calendar prints a one-time warning and falls back to
# storing tokens in plaintext. Fine for local dev; do not deploy that way.
CALENDAR_TOKEN_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# Google Calendar OAuth
# -----------------------------------------------------------------------------
# Create a project at https://console.cloud.google.com → enable
# "Google Calendar API" → OAuth consent screen (External or Internal) →
# Credentials → Create OAuth client ID → "Web application".
#
# Authorised redirect URI must EXACTLY match GOOGLE_REDIRECT_URI below,
# including the scheme. For local dev with ngrok, this is your ngrok URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback


# -----------------------------------------------------------------------------
# Microsoft Outlook / Graph OAuth
# -----------------------------------------------------------------------------
# Register an app at https://entra.microsoft.com → Identity → App
# registrations → New registration. Pick "Accounts in any organizational
# directory and personal Microsoft accounts" for the multi-tenant config
# this app expects. Add a redirect URI of type Web matching
# MICROSOFT_REDIRECT_URI below.
#
# In the app's API permissions, grant delegated:
#   Calendars.ReadWrite, User.Read, offline_access, email, openid
#
# Then under Certificates & secrets → New client secret.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/calendar/microsoft/callback


# -----------------------------------------------------------------------------
# Push delivery (webhooks)
# -----------------------------------------------------------------------------
# Public origin where Google + Microsoft can POST change notifications.
# In production this is your deployed host (no trailing slash). In dev,
# run `ngrok http 3000` and paste the https URL here.
#
# When unset, the OAuth callbacks skip wiring push subscriptions and the
# calendar relies on the focus-based 5-min refresh + manual button.
# Everything else still works.
CALENDAR_WEBHOOK_BASE=

# Bearer token a cron service must present to call
# `/api/calendar/renew-subscriptions`. The route renews Google watch
# channels (max 7d) and Microsoft subscriptions (~3d). Schedule the cron
# every 6–24h depending on your tolerance for a single missed renewal.
#
#   openssl rand -hex 32
#
# When unset, the renewal endpoint returns 503 and push will start
# silently expiring after ~3–7 days.
CALENDAR_RENEWAL_SECRET=


# -----------------------------------------------------------------------------
# Liveblocks AI Copilot (calendar assistant)
# -----------------------------------------------------------------------------
# The calendar's "Ask Claude" panel uses the Liveblocks AI Copilots
# infrastructure. The copilot itself (model + system prompt + API key)
# is configured in the Liveblocks dashboard, not in env — only the id
# lands here so the client knows which copilot to use.
#
# Setup:
#   1. Liveblocks dashboard → your project → "AI Copilots" → Create copilot
#   2. Pick a provider (Anthropic recommended) + model (Claude Sonnet 4.6+)
#   3. Paste your Anthropic API key into the dashboard
#   4. System prompt: leave default — the calendar registers its own
#      contextual prompts via RegisterAiKnowledge at runtime
#   5. Copy the copilot id (starts with `co_`) below
#
# When unset, the chat falls back to Liveblocks' built-in default copilot,
# which is fine for local exploration but rate-limited and not branded.
NEXT_PUBLIC_LIVEBLOCKS_COPILOT_ID=
