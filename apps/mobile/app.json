{
  "expo": {
    "name": "hotelclaw",
    "slug": "hotelclaw",
    "version": "1.0.0",
    "scheme": "hotelclaw",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hotelclaw.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hotelclaw.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": "hotelclaw uses the microphone to record voice messages for your team's chat channels."
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "hotelclaw needs access to your photo library so you can share photos — room issues, deliveries, maintenance — with your team in chat.",
          "cameraPermission": "hotelclaw uses the camera so you can snap and share photos of what's happening on property directly in chat.",
          "microphonePermission": "hotelclaw uses the microphone when you record videos to share with your team."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "hotelclaw shows your recent photos in the attachment picker so you can share them with your team.",
          "savePhotosPermission": "hotelclaw saves photos you choose to download from chat to your photo library."
        }
      ],
      "expo-document-picker",
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "44766015-c288-4987-a593-e89d6c625f41"
      }
    },
    "owner": "okanjis-team"
  }
}
