# Mobile (Expo) env. EXPO_PUBLIC_* values are inlined into the client bundle,
# so ONLY public values belong here — never STREAM_API_SECRET or the Supabase
# service-role key. User tokens are minted at runtime by the web backend.

# Same public key as the web app's NEXT_PUBLIC_STREAM_API_KEY.
EXPO_PUBLIC_STREAM_API_KEY=

# Same project as the web app's NEXT_PUBLIC_SUPABASE_URL /
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Base URL of the Next.js web app, which hosts /api/stream/token.
# iOS simulator can use http://localhost:3000; a physical device needs your
# machine's LAN IP (e.g. http://192.168.1.20:3000) or a deployed URL.
EXPO_PUBLIC_API_URL=http://localhost:3000
