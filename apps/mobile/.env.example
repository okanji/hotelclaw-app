# Stream Chat — mobile (Expo). EXPO_PUBLIC_* values are inlined into the client
# bundle, so only the PUBLIC API key and a dev user token belong here.

# Same public key as the web app's NEXT_PUBLIC_STREAM_API_KEY.
EXPO_PUBLIC_STREAM_API_KEY=

# The Stream user to connect as. Must be a member of at least one channel or the
# channel list renders empty.
EXPO_PUBLIC_STREAM_USER_ID=
EXPO_PUBLIC_STREAM_USER_NAME=

# DEV ONLY token. In production, fetch a user token from your backend / token
# provider at runtime instead of baking it in. NEVER put STREAM_API_SECRET here.
EXPO_PUBLIC_STREAM_USER_TOKEN=
