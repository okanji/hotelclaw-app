{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "eve/workflow-modules"]
  },
  "include": ["agent/**/*.ts", "evals/**/*.ts"],
  "exclude": ["node_modules", ".output", ".eve"]
}
