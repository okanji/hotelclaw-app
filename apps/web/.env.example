# =============================================================================
# hotelclaw-app — apps/web/.env.example — copy to .env.local (gitignored) and fill in
#
# Restart `pnpm dev` after editing — Next reads .env files only on boot.
# The eve agent runtime (apps/agent) is mounted inside this same server and
# reads these same variables, so this is the ONE env file for local dev.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle. Everything else
# stays server-only.
#
# Blocks are ordered by how much breaks without them:
#   1. REQUIRED      — the app does not load / core surfaces error
#   2. AI            — every bot, brief, suggestion, assistant
#   3. OPTIONAL      — a single feature degrades or hides
# =============================================================================


# -----------------------------------------------------------------------------
# 1. REQUIRED — Supabase (auth, every database read and write)
# -----------------------------------------------------------------------------
# Supabase dashboard → project "Hotelclaw" (uoeaapdeyhmplxyswrqo) →
# Settings → API keys.
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable" key (sb_publishable_…). Browser-safe; RLS is the real gate.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret" key (sb_secret_…). Server-only; bypasses RLS for notifications,
# workflows, insights, bookings, and every bot write. Treat as a DB password.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# 1. REQUIRED — Stream Chat (chat + video; the shell waits on this connection)
# -----------------------------------------------------------------------------
# Stream dashboard → your app → App settings → Keys.
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_API_SECRET=
# Stream user id the channel bot posts as. Keep stable across environments.
STREAM_BOT_USER_ID=hotelclaw-ai

# -----------------------------------------------------------------------------
# 1. REQUIRED — Liveblocks (documents, calendar rooms, comments)
# -----------------------------------------------------------------------------
# Liveblocks dashboard → project → API keys → Secret key (sk_…).
LIVEBLOCKS_SECRET_KEY=
# Verifies Liveblocks webhook payloads (doc updates + comment events).
LIVEBLOCKS_WEBHOOK_SECRET=
# Comment-bot user id (shared with the Stream bot). Default hotelclaw-ai.
LIVEBLOCKS_BOT_USER_ID=hotelclaw-ai
# Liveblocks dashboard → AI Copilots → copilot id (co_…) for the calendar panel.
NEXT_PUBLIC_LIVEBLOCKS_COPILOT_ID=

# -----------------------------------------------------------------------------
# 1. REQUIRED — App origin
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production origin used by `scripts/configure-stream-webhook.mjs prod`.
PROD_APP_URL=https://hotelclaw-app.vercel.app


# -----------------------------------------------------------------------------
# 2. AI — Anthropic (every bot: channel bot, assistant, agents, briefs,
#    triage, suggestions, chatbots, memory distillation)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional model overrides. Leave blank for the defaults in code.
AI_BOT_MODEL=
AI_FAST_MODEL=
STREAM_BOT_MODEL=
STREAM_BOT_CLASSIFIER_MODEL=
LIVEBLOCKS_BOT_MODEL=

# -----------------------------------------------------------------------------
# 2. AI — Upstash Redis (bot turn locks, rate limits, suggestion cache)
# -----------------------------------------------------------------------------
# console.upstash.com → database → REST URL + REST token (read+write).
# Fail-soft when unset, but the channel bot's concurrency lock needs it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# 2. AI — other providers (optional)
# -----------------------------------------------------------------------------
# Hybrid chatbot retrieval (text-embedding-3-small). Unset = FTS only.
OPENAI_API_KEY=
# Grok, used by meeting summarisation when selected. Unset = Anthropic only.
XAI_API_KEY=


# -----------------------------------------------------------------------------
# 3. OPTIONAL — Email (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
# From-address once a domain is verified at resend.com/domains,
# e.g. "Hotelclaw <invites@hotelclaw.com>". Unset = onboarding@resend.dev.
EMAIL_FROM=
# Sender for the workflow "send email" step when the step leaves From blank.
RESEND_FROM_EMAIL=

# -----------------------------------------------------------------------------
# 3. OPTIONAL — Guest chatbots / public booking
# -----------------------------------------------------------------------------
# HMAC secret for guest session tokens, booking manage links, and the
# AES key for custom-action headers. Falls back to STREAM_API_SECRET.
#   openssl rand -hex 32
CHATBOT_SESSION_SECRET=
# Twilio, for WhatsApp/SMS chatbot channels. Unset = synchronous TwiML,
# signature validation skipped (dev only).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# 3. OPTIONAL — Workflow "send message" steps (external channels)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# -----------------------------------------------------------------------------
# 3. OPTIONAL — Cron + internal route protection
# -----------------------------------------------------------------------------
# Bearer presented by Vercel cron to /api/insights/*, /api/memory/consolidate,
# /api/chatbots/auto-retrain. Unset in dev = those routes refuse.
#   openssl rand -hex 32
CRON_SECRET=
# Protects /api/workflows/dispatch. Unset = unprotected (dev only).
INTERNAL_DISPATCH_SECRET=
# Where web code reaches eve when not same-origin. Unset = same origin.
EVE_INTERNAL_ORIGIN=

# -----------------------------------------------------------------------------
# 3. OPTIONAL — Calendar sync (Google / Outlook). Without these the in-app
#    calendar works; only external sync, push delivery and at-rest token
#    encryption are lost.
# -----------------------------------------------------------------------------
#   openssl rand -base64 32   (generate once; never rotate without re-encrypting)
CALENDAR_TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/calendar/microsoft/callback
# Public https origin (ngrok in dev) where Google/Microsoft POST changes.
CALENDAR_WEBHOOK_BASE=
#   openssl rand -hex 32
CALENDAR_RENEWAL_SECRET=
