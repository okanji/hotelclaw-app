# =============================================================================
# hotelclaw-app — environment variables
#
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# gitignored; never commit secrets. Restart `pnpm dev` after changes — Next
# only reads .env files on boot.
#
# Variables prefixed with NEXT_PUBLIC_ are inlined into the browser bundle
# and exposed to every visitor. Everything else stays server-only.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Project URL — visible in the Supabase dashboard under Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anonymous "publishable" key. Safe to ship to the browser; RLS is the
# real authorization layer.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGci...

# Service-role key. NEVER exposed to the browser. Used by webhook receivers
# and the calendar push helpers, which run without a user session and need
# to bypass RLS to write `external_events` etc. Treat like a database
# password.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...


# -----------------------------------------------------------------------------
# Stream Chat (messaging + video)
# -----------------------------------------------------------------------------
# Public API key — used by the browser client to connect.
NEXT_PUBLIC_STREAM_API_KEY=...

# Server-side secret for minting user tokens, posting system messages,
# verifying webhook signatures.
STREAM_API_SECRET=...

# Production origin used by `scripts/configure-stream-webhook.mjs prod` to
# point Stream's shared message.new hook back at the deployed app after a
# local dev session. Defaults to https://hotelclaw-app.vercel.app if unset.
PROD_APP_URL=https://hotelclaw-app.vercel.app

# -----------------------------------------------------------------------------
# In-channel AI agent (Stream Chat + Vercel AI SDK)
# -----------------------------------------------------------------------------
# Activated per channel via POST /api/stream/ai/start. Without these, the
# endpoint returns 500 and chat keeps working without the bot.
#
# Stream user id the agent posts as. Default "hotelclaw-ai" — keep stable
# across environments so message history attribution is consistent.
STREAM_BOT_USER_ID=hotelclaw-ai

# Optional override for the Anthropic model id the agent uses. Defaults to
# the project's currently-most-capable Sonnet.
STREAM_BOT_MODEL=

# Optional override for the auto-mode classifier model. Per-message
# decisions of "should the bot chime in?" — Haiku is fast + cheap and the
# right tier for a binary classifier. Default: claude-haiku-4-5.
STREAM_BOT_CLASSIFIER_MODEL=

# -----------------------------------------------------------------------------
# Bot runtime (Tier 1 in-app AI bots)
# -----------------------------------------------------------------------------
# Shared by every in-app bot via lib/ai/run-bot.ts. See AGENTS.md
# "Two-tier AI architecture" for context.

# Optional override of the model used by all Tier 1 bots (channel, task,
# doc, calendar, etc.). Defaults to claude-sonnet-4-6. Per-bot overrides
# (e.g. STREAM_BOT_MODEL) take precedence when present.
AI_BOT_MODEL=

# -----------------------------------------------------------------------------
# gbrain (shared brain substrate via MCP) — DEV / SHARED-INSTANCE FALLBACK
# -----------------------------------------------------------------------------
# Tier-substrate of the two-tier architecture. Every in-app bot — and
# eventually OpenClaw — reads/writes the same memory pool via gbrain's
# MCP server. Tools are auto-injected by runBot() via schema discovery
# when these are set.
#
# Target deployment is per-property: one gbrain process per property,
# each connected to its own Postgres database (one brain per property)
# inside a shared Supabase cluster. Per-property URL + token will then
# live on `properties` rows (gbrain_mcp_url / gbrain_mcp_token) and
# `resolvePropertyGbrainConfig(propertyId)` will read those first.
#
# Until per-property provisioning is wired up, these env vars act as a
# single shared-instance fallback — fine for local dev and staging
# integration tests. When unset, `getGbrainClient(propertyId)` returns
# null and bots run without gbrain tools (still functional, no shared
# memory). One-time warning per property on first miss.
# See lib/ai/gbrain-config.ts + lib/ai/mcp-clients.ts.
GBRAIN_MCP_URL=
GBRAIN_MCP_TOKEN=

# -----------------------------------------------------------------------------
# OpenClaw (Tier 2 — persistent agent) — DEV / SHARED-INSTANCE FALLBACK
# -----------------------------------------------------------------------------
# When provisioned, in-app bots can delegate long-running/scheduled/cross-
# channel work to OpenClaw via the delegate_to_openclaw tool (see
# lib/ai/tools/delegate.ts). Until then the tool runs as a logging stub.
#
# Target deployment mirrors gbrain: one OpenClaw process per property.
# Per-property URL + token will live on `properties` rows
# (openclaw_api_url / openclaw_api_token) and
# `resolvePropertyOpenclawConfig(propertyId)` will read those first.
# These env vars are a single shared-instance fallback for dev/staging.
#
# Set both to enable live delegation:
OPENCLAW_API_URL=
OPENCLAW_API_TOKEN=

# -----------------------------------------------------------------------------
# Upstash Redis (engaged-mode tool history)
# -----------------------------------------------------------------------------
# Stores the AI bot's per-engaged-conversation tool history so it can build
# on its earlier tool calls/results across turns without re-querying.
# See lib/stream/ai-turn-history.ts. Keys auto-expire after 24h (TTL backstop
# in case the explicit cleanup on disengage is missed).
#
# Set up at https://console.upstash.com — create a Redis database, then copy
# the REST URL and REST Token (the one with read+write, not read-only) from
# the database details page.
#
# When unset, engaged mode still works — the bot just loses cross-turn memory
# (re-calls tools each turn). A one-time warning logs on first use.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Anthropic API key. Used by @stream-io/chat-ai-sdk's Vercel AI SDK wrapper
# when AgentPlatform.ANTHROPIC is selected.
ANTHROPIC_API_KEY=


# -----------------------------------------------------------------------------
# Liveblocks (collaborative docs + presence)
# -----------------------------------------------------------------------------
# Server-side secret for room access tokens.
LIVEBLOCKS_SECRET_KEY=sk_...

# Verifies Liveblocks webhook payloads (document update notifications and
# comment events forwarded to the bot below).
LIVEBLOCKS_WEBHOOK_SECRET=whsec_...

# Stable user id the comment bot posts as. Reply attribution + @-mention
# matching keys off this. Default "hotelclaw-ai" (shared with the Stream bot).
LIVEBLOCKS_BOT_USER_ID=hotelclaw-ai

# Optional override for the Anthropic model id the comment bot uses.
LIVEBLOCKS_BOT_MODEL=


# -----------------------------------------------------------------------------
# Resend (transactional email — invites, password resets)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_...

# From-address for all outbound email. Leave unset to use Resend's shared
# onboarding@resend.dev (which ONLY delivers to your own Resend account email —
# real invites 403 until you verify a domain). Once a domain is verified at
# resend.com/domains, set this to e.g. "Hotelclaw <invites@hotelclaw.com>".
EMAIL_FROM=


# =============================================================================
# Calendar integration (migration 0017 + 0018)
# =============================================================================
# Everything below is optional. Without it, the in-app calendar still
# works — you just lose external sync (Google/Outlook), push delivery
# (events appear on next focus-poll instead), and at-rest token encryption.
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# Token encryption
# -----------------------------------------------------------------------------
# AES-256-GCM key for encrypting `calendar_connections.access_token` /
# `refresh_token` at rest. Generate ONCE per environment and never rotate
# without re-encrypting (a rotation script would walk all rows, decrypt
# with the old key, encrypt with the new one).
#
#   openssl rand -base64 32
#
# When unset, the calendar prints a one-time warning and falls back to
# storing tokens in plaintext. Fine for local dev; do not deploy that way.
CALENDAR_TOKEN_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# Google Calendar OAuth
# -----------------------------------------------------------------------------
# Create a project at https://console.cloud.google.com → enable
# "Google Calendar API" → OAuth consent screen (External or Internal) →
# Credentials → Create OAuth client ID → "Web application".
#
# Authorised redirect URI must EXACTLY match GOOGLE_REDIRECT_URI below,
# including the scheme. For local dev with ngrok, this is your ngrok URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback


# -----------------------------------------------------------------------------
# Microsoft Outlook / Graph OAuth
# -----------------------------------------------------------------------------
# Register an app at https://entra.microsoft.com → Identity → App
# registrations → New registration. Pick "Accounts in any organizational
# directory and personal Microsoft accounts" for the multi-tenant config
# this app expects. Add a redirect URI of type Web matching
# MICROSOFT_REDIRECT_URI below.
#
# In the app's API permissions, grant delegated:
#   Calendars.ReadWrite, User.Read, offline_access, email, openid
#
# Then under Certificates & secrets → New client secret.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/calendar/microsoft/callback


# -----------------------------------------------------------------------------
# Push delivery (webhooks)
# -----------------------------------------------------------------------------
# Public origin where Google + Microsoft can POST change notifications.
# In production this is your deployed host (no trailing slash). In dev,
# run `ngrok http 3000` and paste the https URL here.
#
# When unset, the OAuth callbacks skip wiring push subscriptions and the
# calendar relies on the focus-based 5-min refresh + manual button.
# Everything else still works.
CALENDAR_WEBHOOK_BASE=

# Bearer token a cron service must present to call
# `/api/calendar/renew-subscriptions`. The route renews Google watch
# channels (max 7d) and Microsoft subscriptions (~3d). Schedule the cron
# every 6–24h depending on your tolerance for a single missed renewal.
#
#   openssl rand -hex 32
#
# When unset, the renewal endpoint returns 503 and push will start
# silently expiring after ~3–7 days.
CALENDAR_RENEWAL_SECRET=


# -----------------------------------------------------------------------------
# Liveblocks AI Copilot (calendar assistant)
# -----------------------------------------------------------------------------
# The calendar's "Ask Claude" panel uses the Liveblocks AI Copilots
# infrastructure. The copilot itself (model + system prompt + API key)
# is configured in the Liveblocks dashboard, not in env — only the id
# lands here so the client knows which copilot to use.
#
# Setup:
#   1. Liveblocks dashboard → your project → "AI Copilots" → Create copilot
#   2. Pick a provider (Anthropic recommended) + model (Claude Sonnet 4.6+)
#   3. Paste your Anthropic API key into the dashboard
#   4. System prompt: leave default — the calendar registers its own
#      contextual prompts via RegisterAiKnowledge at runtime
#   5. Copy the copilot id (starts with `co_`) below
#
# When unset, the chat falls back to Liveblocks' built-in default copilot,
# which is fine for local exploration but rate-limited and not branded.
NEXT_PUBLIC_LIVEBLOCKS_COPILOT_ID=
