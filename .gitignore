node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# turborepo
.turbo

# testing
coverage/

# next.js
.next/
out/

# production
build/

