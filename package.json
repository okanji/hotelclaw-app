{
  "name": "hotelclaw-monorepo",
  "private": true,
  "packageManager": "pnpm@10.2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev-doctor.mjs && turbo run dev --filter=web",
    "dev:mobile": "node scripts/dev-doctor.mjs && turbo run dev --filter=mobile",
    "dev:all": "node scripts/dev-doctor.mjs && turbo run dev",
    "dev:stop": "node scripts/dev-doctor.mjs --stop",
    "dev:doctor": "node scripts/dev-doctor.mjs --check",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "web": "pnpm --filter web",
    "mobile": "pnpm --filter mobile"
  },
  "devDependencies": {
    "turbo": "^2.10.0"
  },
  "pnpm": {
    "overrides": {
      "stream-chat": "9.47.1",
      "react": "19.2.3",
      "react-dom": "19.2.3"
    }
  }
}
